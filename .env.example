# Qwen3-TTS FastAPI Configuration

# Service
APP_NAME="Qwen3-TTS API"
APP_VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Model
DEFAULT_MODEL="Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice"
MODEL_DEVICE="cuda:0"
MODEL_DTYPE="bfloat16"
FLASH_ATTENTION=true

# Auto-unload
QWEN_TTS_UNLOAD_SECS=120

# Concurrency
MAX_CONCURRENT_REQUESTS=4
MAX_QUEUE_SIZE=100
REQUEST_TIMEOUT=300

# Security (optional)
# API_KEY="your-secret-api-key-here"
CORS_ORIGINS=["*"]
RATE_LIMIT="100/minute"

# Audio
MAX_INPUT_LENGTH=10000
MAX_BATCH_SIZE=10
DEFAULT_SAMPLE_RATE=24000

# Logging
LOG_LEVEL="INFO"
LOG_JSON=true

# Responsible AI
REQUIRE_CONSENT=true
ADD_WATERMARK=true
