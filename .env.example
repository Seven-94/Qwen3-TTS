# API Configuration
QWEN3_TTS_API_KEY=your-api-key-here
API_HOST=0.0.0.0
API_PORT=8000

# UI Configuration
UI_PORT=7860
UI_SHARE=false

# GPU Configuration
DEVICE=cuda
DTYPE=bfloat16
ATTENTION_IMPLEMENTATION=flash_attention_2

# Paths
MODELS_DIR=modele_tts
VOICES_DIR=voices
CACHE_DIR=cache

# ASR Configuration
ASR_MODEL=openai/whisper-large-v3
ASR_DEVICE=cuda

# Audio Output
OUTPUT_FORMAT=mp3
OUTPUT_SAMPLE_RATE=24000
